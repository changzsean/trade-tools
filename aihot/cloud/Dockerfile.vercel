FROM node:24-trixie-slim
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ADD --chown=node:node source.tar.gz /app/
RUN npm ci --omit=dev --no-audit --no-fund
COPY --chown=node:node supabase-ca.crt /app/certs/supabase-root.crt
ENV NODE_EXTRA_CA_CERTS=/app/certs/supabase-root.crt
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=8080 PORT=8080 AIHOT_DATA_DIR=/tmp/meeka
ADD --chown=node:node https://raw.githubusercontent.com/changzsean/trade-tools/c1453b1a8bba606dfa28dc9bcf972c702e89d355/aihot/assets/og-fonts/noto-sans-sc-400.ttf /app/assets/og-fonts/noto-sans-sc-400.ttf
ADD --chown=node:node https://raw.githubusercontent.com/changzsean/trade-tools/c1453b1a8bba606dfa28dc9bcf972c702e89d355/aihot/assets/og-fonts/noto-sans-sc-700.ttf /app/assets/og-fonts/noto-sans-sc-700.ttf
USER node
EXPOSE 8080
CMD ["node", "scripts/cloud-api.ts"]
