# Alibaba.com Open Platform OAuth (server-only values)
ALIBABA_APP_KEY=replace_with_app_key
ALIBABA_APP_SECRET=replace_with_app_secret
ALIBABA_TOKEN_COOKIE_SECRET=replace_with_a_long_random_secret
ALIBABA_PUBLIC_BASE_URL=https://meeka.com.cn

# Defaults target the current Alibaba Open API. Override only if the API console
# for your application specifies a different environment or endpoint.
ALIBABA_OAUTH_AUTHORIZE_URL=https://open-api.alibaba.com/oauth/authorize
ALIBABA_TOKEN_ENDPOINT=https://open-api.alibaba.com/rest/auth/token/create
ALIBABA_TOKEN_METHOD=/auth/token/create
